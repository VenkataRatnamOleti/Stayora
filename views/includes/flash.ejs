<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fade show col-lg-6 col-12 offset-lg-3 mt-3" role="alert">
        <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" arial-label="Close"></button>
    </div>
<% } %>

<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show col-lg-6 col-12 offset-lg-3 mt-3" role="alert">
        <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" arial-label="Close"></button>
    </div>
<% } %>